@model IEnumerable<GenreServiceModel>
@{
    ViewData["Title"] = "Genres";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Genres</h1>
    <a asp-action="Create" class="btn btn-success">+ Add Genre</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th style="width: 200px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var genre in Model)
        {
            <tr>
                <td>@genre.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@genre.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@genre.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this genre?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
